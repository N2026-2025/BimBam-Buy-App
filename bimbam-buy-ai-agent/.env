# Elegí el proveedor de LLM/embeddings: openai | google | cohere
#LLM_PROVIDER=openai
#EMBEDDINGS_PROVIDER=openai

# Modelos (ajustar según el proveedor elegido)
#LLM_MODEL=gpt-4o-mini 
#EMBEDDINGS_MODEL=text-embedding-3-small

# LLM por API (Google - Ultra rápido y barato)
LLM_PROVIDER=google
LLM_MODEL=gemini-3.1-flash-lite

# EMBEDDINGS locales (ONNX - Gratis, privado y local en OCI)
EMBEDDINGS_PROVIDER=onnx
EMBEDDINGS_MODEL=xenova/bge-small-en-v1.5  # Ejemplo de modelo optimizado para ONNX Runtime

# Credenciales (completar según el proveedor)
OPENAI_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=

# Configuración de RAG (opcional, valores por defecto ya definidos en el código)
DATA_DIR=data
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION=bimbam_buy_kb
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_K=4
